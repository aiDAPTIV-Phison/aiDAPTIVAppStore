<?xml version="1.0" encoding="utf-8"?>
<!--
  ╔══════════════════════════════════════════════════════════════════════════════╗
  ║                        App Branding Configuration                            ║
  ╠══════════════════════════════════════════════════════════════════════════════╣
  ║  修改此檔案中的值，然後重新編譯即可更換 App 名稱和圖標。                      ║
  ║                                                                              ║
  ║  使用方式：                                                                  ║
  ║  1. 修改下方的 AppDisplayName（App 顯示名稱）                                ║
  ║  2. 修改 AppDescription（App 描述）                                          ║
  ║  3. 如需更換圖標，修改 AppIconFileName 並放置對應的圖標檔案                  ║
  ║  4. 重新編譯專案                                                             ║
  ╚══════════════════════════════════════════════════════════════════════════════╝
-->
<Project>
  <PropertyGroup>
    <!-- ════════════════════════════════════════════════════════════════════════ -->
    <!-- App 顯示名稱（用於視窗標題、通知、安裝程式等）                            -->
    <!-- ════════════════════════════════════════════════════════════════════════ -->
    <AppDisplayName>aiDAPTIVAppStore</AppDisplayName>
    
    <!-- ════════════════════════════════════════════════════════════════════════ -->
    <!-- App 描述                                                                 -->
    <!-- ════════════════════════════════════════════════════════════════════════ -->
    <AppDescription>aiDAPTIVAppStore</AppDescription>
    
    <!-- ════════════════════════════════════════════════════════════════════════ -->
    <!-- App 圖標檔案路徑（相對於 UniGetUI 專案根目錄）                            -->
    <!-- ════════════════════════════════════════════════════════════════════════ -->
    <AppIconPath>icon.ico</AppIconPath>
    
    <!-- ════════════════════════════════════════════════════════════════════════ -->
    <!-- App 圖標在 Assets/Images 中的檔案名稱                                    -->
    <!-- ════════════════════════════════════════════════════════════════════════ -->
    <AppIconFileName>icon.ico</AppIconFileName>
    
    <!-- ════════════════════════════════════════════════════════════════════════ -->
    <!-- 捷徑檔案名稱（不含副檔名，用於開始選單和桌面捷徑）                        -->
    <!-- ════════════════════════════════════════════════════════════════════════ -->
    <AppShortcutName>aiDAPTIVAppStore</AppShortcutName>
    
    <!-- ════════════════════════════════════════════════════════════════════════ -->
    <!-- 可執行檔名稱（不含副檔名，編譯後的 .exe 檔案名稱）                        -->
    <!-- ════════════════════════════════════════════════════════════════════════ -->
    <AppExecutableName>aiDAPTIVAppStore</AppExecutableName>
    
    <!-- ════════════════════════════════════════════════════════════════════════ -->
    <!-- App 識別碼（用於 Windows 系統識別）                                      -->
    <!-- ════════════════════════════════════════════════════════════════════════ -->
    <AppIdentifier>Phison.aiDAPTIVAppStore</AppIdentifier>
    
    <!-- ════════════════════════════════════════════════════════════════════════ -->
    <!-- 使用者資料夾名稱（位於 %LocalAppData% 中）                               -->
    <!-- ════════════════════════════════════════════════════════════════════════ -->
    <AppDataFolderName>aiDAPTIVAppStore</AppDataFolderName>
    
    <!-- ════════════════════════════════════════════════════════════════════════ -->
    <!-- 備份資料夾名稱（位於 Documents 中）                                      -->
    <!-- ════════════════════════════════════════════════════════════════════════ -->
    <AppBackupFolderName>aiDAPTIVAppStore</AppBackupFolderName>
  </PropertyGroup>
</Project>
